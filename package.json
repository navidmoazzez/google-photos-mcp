{
  "name": "@thenavidm/google-photos-mcp",
  "version": "1.1.0",
  "description": "Google Photos MCP server for Claude Code and AI agents. Photo picker, uploads, albums, sharing, enrichments, descriptions, app-created media search, and multiple Google accounts.",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "google-photos-mcp": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "lint": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.0",
    "eslint": "^10.9.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "author": "Navid Moazzez (https://navid.me)",
  "homepage": "https://github.com/navidmoazzez/google-photos-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navidmoazzez/google-photos-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/navidmoazzez/google-photos-mcp/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
